VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Só para demonstrar sem banco (dados ficam no navegador). Em desenvolvimento
# o modo demonstração já liga sozinho quando as variáveis acima estão vazias.
# VITE_MODO_DEMO=true

# O e-mail da equipe fica em src/lib/contato.js. O link do grupo de ajuda no
# WhatsApp NÃO vai para o repositório (é público e o grupo mostra o telefone
# de quem participa): configure só na Vercel. Sem ele, o botão não aparece.
# VITE_GRUPO_WHATSAPP=https://chat.whatsapp.com/...

# Nunca coloque aqui chaves de IA nem chaves secretas: tudo com prefixo VITE_
# vai para o navegador. A chave do Gemini fica só nos Secrets da Edge Function
# ler-cardapio (README, "Importar o cardápio por foto").
